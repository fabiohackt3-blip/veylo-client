<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Veylo</AssemblyName>
    <RootNamespace>Veylo.Launcher</RootNamespace>
    <Version>0.5.0</Version>
    <Product>Veylo Client</Product>
    <Company>Veylo</Company>
    <Description>Minecraft Java Launcher und Instanzverwaltung</Description>
    <ApplicationIcon>Assets/Veylo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Veylo.ico" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <None Include="../../mod/build/launcher-mods/*.jar" Link="mods/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
