<Window x:Class="Veylo.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veylo Client" Width="820" Height="610" MinWidth="740" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#10101A" Foreground="#F5EEFF"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#33284B" />
            <Setter Property="Foreground" Value="#F5EEFF" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFill" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFill" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFill" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="38,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,19">
                <TextBlock DockPanel.Dock="Right" Text="BUILD 0.1.0" Foreground="#AE99CC"
                           VerticalAlignment="Center" FontSize="12" />
                <TextBlock Text="V E Y L O" FontWeight="Bold" FontSize="19" Foreground="#D5B8FF" />
            </DockPanel>
            <Border Grid.Row="1" CornerRadius="18" Padding="30,24" Margin="0,0,0,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#402867" Offset="0"/>
                        <GradientStop Color="#241C39" Offset="0.65"/>
                        <GradientStop Color="#191626" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="MINECRAFT JAVA   /   1.21.11 + FABRIC" FontSize="12" Foreground="#E0C9FF" />
                    <TextBlock Text="Veylo Client" FontSize="46" FontWeight="Bold" Margin="0,2,0,2" />
                    <TextBlock Text="Öffne dein Veylo-Menü im Spiel mit rechter Shift-Taste." Foreground="#D6C7E8" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" CornerRadius="14" Background="#1C1828" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ProfilePanel">
                        <TextBlock Text="SPIELPROFIL" Foreground="#B7A4CC" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProfilePicker" DisplayMemberPath="Name" Margin="0,8,0,8"
                                  Height="31" SelectionChanged="ProfileChanged" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Hinzufügen" Click="AddProfile" Margin="8,0,0,0" />
                            <TextBox x:Name="ProfileName" MaxLength="32" Padding="7" VerticalContentAlignment="Center"
                                     ToolTip="Name des neuen Profils" />
                        </DockPanel>
                        <TextBlock x:Name="RamLabel" Text="Arbeitsspeicher" Margin="0,14,0,3" />
                        <Slider x:Name="Ram" Minimum="2048" Maximum="12288" Value="4096" TickFrequency="512"
                                IsSnapToTickEnabled="True" ValueChanged="RamChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MICROSOFT-KONTO" Foreground="#B7A4CC" FontWeight="SemiBold" />
                        <TextBlock x:Name="Account" Text="Nicht angemeldet" Margin="0,8,0,8" />
                        <WrapPanel>
                            <Button x:Name="SignInButton" Content="Anmelden" Click="SignIn" />
                            <Button x:Name="PlayButton" Content="Spielen" Click="Play"
                                    Background="#B88DF9" Foreground="#180D28" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock x:Name="Status" Text="Bereit" TextWrapping="Wrap" Margin="0,13,0,0"
                                   Foreground="#D5C4EA" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
