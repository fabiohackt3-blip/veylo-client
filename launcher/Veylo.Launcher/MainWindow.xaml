<Window x:Class="Veylo.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veylo Client" Icon="Assets/Veylo.ico" Width="1080" Height="780" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#0A1118" Foreground="#EBF4FA"
        FontFamily="Segoe UI" UseLayoutRounding="True" Closed="WindowClosed" Closing="WindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#66D2FF"/>
        <SolidColorBrush x:Key="Muted" Color="#A3B6C7"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EBF4FA"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2B39"/>
            <Setter Property="Foreground" Value="#E8F6FF"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7"
                                BorderThickness="1" BorderBrush="#365266">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="BorderBrush" Value="#66D2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value=".76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Opacity" Value=".46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="#111C26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="#0B141D"/>
            <Setter Property="Foreground" Value="#E8F6FF"/>
            <Setter Property="BorderBrush" Value="#365266"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DBE8F1"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#131F29"/>
            <Setter Property="BorderBrush" Value="#293E4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#101922" BorderThickness="0,0,1,0" BorderBrush="#293E4D">
            <DockPanel Margin="15,24,15,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,0,0,24">
                    <Image Source="Assets/Veylo.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="VEYLO" FontSize="22" FontWeight="Bold" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="VEYLO · 0.5.1" Foreground="{StaticResource Muted}" Margin="7,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Navigation">
                    <Button Style="{StaticResource Navigation}" Content="Home" Tag="Home" Click="Navigate"/>
                    <StackPanel x:Name="RecentSection" Visibility="Collapsed" Margin="8,0,0,8">
                        <TextBlock Text="ZULETZT GESPIELT" Foreground="{StaticResource Muted}" FontSize="10" Margin="4,2,0,5"/>
                        <ItemsControl x:Name="RecentInstances">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Navigation}" CommandParameter="{Binding}" Click="OpenRecentInstance"
                                            Padding="8,5" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                        <StackPanel Width="103">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                            <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Style="{StaticResource Navigation}" Content="Versionen" Tag="Versions" Click="Navigate"/>
                    <Button Style="{StaticResource Navigation}" Content="Mods" Tag="Mods" Click="Navigate"/>
                    <Button Style="{StaticResource Navigation}" Content="Instanzen" Tag="Profiles" Click="Navigate"/>
                    <Button Style="{StaticResource Navigation}" Content="Accounts" Tag="Accounts" Click="Navigate"/>
                    <Button Style="{StaticResource Navigation}" Content="Einstellungen" Tag="Settings" Click="Navigate"/>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24,16,24,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="MINECRAFT JAVA EDITION" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Microsoft-Konto" Tag="Accounts" Click="Navigate"/>
            </DockPanel>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="HomePage">
                        <Border Height="216" Background="#112A3D" CornerRadius="12" ClipToBounds="True">
                            <Grid>
                                <Viewbox Stretch="Fill" Opacity=".58" IsHitTestVisible="False">
                                    <Canvas Width="820" Height="216">
                                        <Path Fill="#214761" Data="M0,155 L104,91 L147,116 L221,55 L300,141 L393,99 L465,130 L595,42 L661,93 L726,27 L820,97 L820,216 L0,216 Z"/>
                                        <Path Fill="#39728B" Data="M535,85 L595,42 L624,64 L600,60 L582,68 L568,69 Z M683,67 L726,27 L766,57 L745,54 L731,44 L719,52 Z"/>
                                        <Path Fill="#122637" Data="M0,149 L83,132 L126,157 L227,138 L268,158 L386,146 L454,169 L568,134 L645,151 L762,119 L820,147 L820,216 L0,216 Z"/>
                                        <Path Fill="#10202C" Data="M0,177 L171,175 L251,184 L386,180 L534,190 L670,171 L820,175 L820,216 L0,216 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center" Margin="26,0">
                                    <TextBlock Text="VEYLO  /  JAVA CLIENT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Text="Bereit zum Spielen" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Deine Minecraft-Instanzen, Welten und Mods" Margin="2,8,0,0"
                                               Foreground="#CFDFE9" TextWrapping="Wrap" FontSize="15"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Aktive Instanz" Foreground="{StaticResource Muted}"/>
                                    <ComboBox x:Name="ProfilePicker" DisplayMemberPath="Name" Margin="0,6,0,0" SelectionChanged="ProfileChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Version" Foreground="{StaticResource Muted}"/>
                                    <Button x:Name="HomeVersion" Content="1.21.11 · Veylo / Fabric" Tag="Versions" Click="Navigate"
                                            Margin="0,6,0,0" HorizontalContentAlignment="Left" Padding="8,4"/>
                                </StackPanel>
                                <Button x:Name="PlayButton" Grid.Column="2" Content="Spielen" Click="Play"
                                        Background="#66D2FF" Foreground="#091923" MinWidth="108" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Veylo 0.5.1" Style="{StaticResource Title}"/>
                                <TextBlock Text="Neues Right-Shift-Menü, überarbeitetes HUD und lokale Cosmetics."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Meine Instanzen" Tag="Profiles" Click="Navigate" Margin="0,0,8,6"/>
                                    <Button Content="Mods verwalten" Tag="Mods" Click="Navigate" Margin="0,0,8,6"/>
                                    <Button Content="Einstellungen" Tag="Settings" Click="Navigate" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="VersionsPage" Visibility="Collapsed">
                        <TextBlock Text="Versionen" Style="{StaticResource Title}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="VersionControls">
                                <TextBlock Text="Minecraft-Version für das aktive Profil" FontWeight="SemiBold"/>
                                <ComboBox x:Name="VersionPicker" Margin="0,9,0,9" SelectionChanged="VersionChanged"/>
                                <CheckBox x:Name="Snapshots" Content="Snapshots anzeigen" Checked="FilterVersions" Unchecked="FilterVersions"/>
                                <TextBlock Text="Modloader" Margin="0,8,0,4"/>
                                <ComboBox x:Name="LoaderPicker" SelectionChanged="LoaderChanged">
                                    <ComboBoxItem Content="Vanilla"/>
                                    <ComboBoxItem Content="Fabric"/>
                                    <ComboBoxItem x:Name="VeyloChoice" Content="Veylo / Fabric (1.21.11)"/>
                                </ComboBox>
                                <TextBlock x:Name="VersionInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                <Button Content="Offizielle Versionsliste aktualisieren" Click="ReloadVersions" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="ModsPage" Visibility="Collapsed">
                        <TextBlock x:Name="ModsTitle" Text="Instanz-Mods" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="ModsInfo" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource Muted}"/>
                        <StackPanel x:Name="ModsControls">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Modrinth entdecken" FontSize="18" FontWeight="SemiBold"/>
                                    <DockPanel Margin="0,10,0,10">
                                        <Button DockPanel.Dock="Right" Content="Suchen" Click="SearchMods" Margin="8,0,0,0"/>
                                        <TextBox x:Name="ModQuery" MaxLength="100" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="Nach Modrinth-Mods suchen" KeyDown="ModQueryKeyDown"/>
                                    </DockPanel>
                                    <ListBox x:Name="SearchResults" Background="#0B141D" Foreground="#E8F6FF" BorderBrush="#365266" Height="194"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,4">
                                                    <TextBlock Text="{Binding Project.Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#A3B6C7" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Auswahl installieren" Background="#66D2FF" Foreground="#091923"
                                                Click="InstallModrinth" Margin="0,0,8,6"/>
                                        <Button x:Name="PreviousMods" Content="Zurück" Click="PreviousModPage" Margin="0,0,8,6" IsEnabled="False"/>
                                        <Button x:Name="NextMods" Content="Weiter" Click="NextModPage" Margin="0,0,8,6" IsEnabled="False"/>
                                        <TextBlock x:Name="ModPageInfo" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Installierte Mods" FontSize="18" FontWeight="SemiBold"/>
                                    <ListBox x:Name="ModList" Background="#0B141D" Foreground="#E8F6FF" BorderBrush="#365266" Height="140" Margin="0,10,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="JAR importieren" Click="ImportMod" Margin="0,0,8,6"/>
                                        <Button Content="Aktivieren / deaktivieren" Click="ToggleMod" Margin="0,0,8,6"/>
                                        <Button Content="Mod-Ordner öffnen" Click="OpenMods" Margin="0,0,8,6"/>
                                        <Button Content="Updates prüfen" Click="CheckModUpdates" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="UpdateInfo" TextWrapping="Wrap" Margin="0,8,0,6"/>
                                    <ListBox x:Name="ModUpdates" Background="#0B141D" Foreground="#E8F6FF" BorderBrush="#365266" Height="110" Visibility="Collapsed"/>
                                    <Button x:Name="ApplyModUpdate" Content="Ausgewählte Mod aktualisieren" Click="UpdateModrinth"
                                            Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
                        <TextBlock Text="Meine Instanzen" Style="{StaticResource Title}"/>
                        <TextBlock Text="Jede Instanz hat eigene Welten, Mods und Einstellungen." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ManageProfiles" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OpenInstanceCard" CommandParameter="{Binding Profile}" Width="168"
                                            Padding="1" Margin="0,0,8,8" HorizontalContentAlignment="Stretch"
                                            AutomationProperties.Name="{Binding Profile.Name}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#131F29"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="True">
                                                        <Setter Property="Background" Value="#21445D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Image Source="{Binding Cover}" Height="88" Stretch="UniformToFill"/>
                                            <TextBlock Text="{Binding Profile.Name}" Margin="9,8,9,2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Profile.Details}" Margin="9,0,9,2" Foreground="#A3B6C7" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Instanz öffnen →" Margin="9,2,9,8" Foreground="{StaticResource Accent}" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="ProfilePanel">
                                <TextBlock x:Name="SelectedInstance" Text="Aktive Instanz" FontWeight="SemiBold" FontSize="17"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Spielen" Click="Play" IsEnabled="{Binding IsEnabled, ElementName=PlayButton}"
                                            Background="#66D2FF" Foreground="#091923" Margin="0,0,8,6"/>
                                    <Button Content="Mods öffnen" Tag="Mods" Click="Navigate" Margin="0,0,8,6"/>
                                    <Button Content="Bild ändern" Click="ChangeCover" Margin="0,0,8,6"/>
                                    <Button Content="Standardbild" Click="ResetCover" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="RamLabel" Text="Arbeitsspeicher" Margin="0,10,0,4"/>
                                <Slider x:Name="Ram" Minimum="2048" Maximum="12288" Value="4096" TickFrequency="512"
                                        IsSnapToTickEnabled="True" ValueChanged="RamChanged"/>
                                <Separator Margin="0,15"/>
                                <TextBlock Text="Neue Instanz" FontWeight="SemiBold" FontSize="17"/>
                                <TextBox x:Name="ProfileName" AutomationProperties.Name="Name der neuen Instanz" MaxLength="32" Margin="0,7,0,9"/>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Minecraft-Version" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="NewVersion" SelectionChanged="NewVersionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Modloader" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="NewLoader" SelectedIndex="1">
                                            <ComboBoxItem Content="Vanilla"/>
                                            <ComboBoxItem Content="Fabric"/>
                                            <ComboBoxItem x:Name="NewVeyloChoice" Content="Veylo / Fabric (1.21.11)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="NewSnapshots" Content="Snapshots anzeigen" Checked="FilterNewVersions" Unchecked="FilterNewVersions"/>
                                <Button Content="Instanz erstellen" Click="AddProfile" Background="#66D2FF" Foreground="#091923" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="AccountsPage" Visibility="Collapsed">
                        <TextBlock Text="Accounts" Style="{StaticResource Title}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MICROSOFT-KONTO" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="Account" Text="Nicht angemeldet" Margin="0,8,0,13" FontSize="19"/>
                                <WrapPanel>
                                    <Button x:Name="SignInButton" Content="Anmelden / Konto wechseln" Click="SignIn" Margin="0,0,8,0"/>
                                    <Button x:Name="SignOutButton" Content="Abmelden" Click="SignOut" IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                        <TextBlock Text="Einstellungen" Style="{StaticResource Title}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Discord Rich Presence" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Füge die Application ID deiner Veylo-Discord-App ein. Discord erhält nur den Launcher-Status und die Minecraft-Version."
                                           TextWrapping="Wrap" Margin="0,8,0,8" Foreground="{StaticResource Muted}"/>
                                <CheckBox x:Name="DiscordEnabled" Content="Discord-Aktivität aktivieren"/>
                                <TextBox x:Name="DiscordId" AutomationProperties.Name="Discord Application ID" MaxLength="20" Margin="0,0,0,9"/>
                                <Button Content="Discord-Einstellungen speichern" Click="SaveDiscord" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="Status" Text="Bereit" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <ProgressBar x:Name="DownloadProgress" Height="5" Margin="0,8,0,0" Visibility="Collapsed"
                                     Foreground="{StaticResource Accent}" Maximum="100"/>
                    </StackPanel>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Abbrechen" Click="CancelInstall" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
